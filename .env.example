# ==============================================================================
# PambantuLog Environment Variables Template
# Copy this file to .env.local and populate with your actual credentials.
# ==============================================================================

# ── 1. Supabase Configuration ─────────────────────────────────────────────────
# Get these from your Supabase Dashboard: Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# New API Keys (Publishable & Secret)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy API Keys (Optional fallback for older JWT anon/service_role keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 2. Database Connection (PostgreSQL / Drizzle ORM) ─────────────────────────
# PostgreSQL connection string (direct or Supabase transaction pooler)
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ── 3. Upstash Redis (Optional for Distributed Rate Limiting) ────────────────
# Leave blank to automatically use local in-memory sliding window rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
